{
  "name": "@blackjack/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json && vite build",
    "build:perf": "vite build --mode perf --outDir dist-perf",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run --config ../../config/vitest.package.ts",
    "perf": "node scripts/perf.mjs",
    "decisions": "node scripts/decisions.mjs",
    "verify": "node scripts/verify.mjs"
  },
  "dependencies": {
    "@blackjack/cards": "workspace:*",
    "@blackjack/client-core": "workspace:*",
    "@blackjack/director": "workspace:*",
    "@blackjack/engine": "workspace:*",
    "@blackjack/fair": "workspace:*",
    "@blackjack/money": "workspace:*",
    "@blackjack/protocol": "workspace:*",
    "@blackjack/renderer": "workspace:*",
    "@blackjack/strategy": "workspace:*",
    "gsap": "catalog:",
    "pixi.js": "catalog:"
  },
  "devDependencies": {
    "@playwright/test": "catalog:",
    "@types/node": "^20",
    "happy-dom": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
